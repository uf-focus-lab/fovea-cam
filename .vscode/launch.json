    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/FoveaCam",
            "miDebuggerPath": "${workspaceFolder}/scripts/sudo_gdb",
            "preLaunchTask": "Build:debug",
            "args": [
                "match",
            ],
            "environment": [
                {
                    "name": "config",
                    "value": "Debug"
                }
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}